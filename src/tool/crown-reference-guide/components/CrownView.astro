      </g>
      <g class="arrow-ccw" opacity="0">
        <path class="arrow-path" d="M 150 74 Q 170 82 180 74" />
        <polygon class="arrow-head" points="180,78 188,74 180,70" />
      </g>
    </g>
  </svg>
