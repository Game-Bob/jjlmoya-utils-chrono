---
import "../styles/chrono-category.css";
import ProductionPage from "./ProductionPage.astro";
import { Icon } from "astro-icon/components";
import { SEORenderer } from "@jjlmoya/utils-shared";
import ProductionBreadcrumb from "../components/ProductionBreadcrumb.astro";
import type { KnownLocale, CategoryLocaleContent } from "../types";
import { getCategoryPath } from "../mfe/routes";
import { getCategoryUi } from "../mfe/category-ui";

interface CategoryTool { id: string; icon: string; title: string; description: string; href: string; }
interface Props { locale: KnownLocale; category: CategoryLocaleContent; tools: CategoryTool[]; alternates: { language: KnownLocale; url: string }[]; image?: string | undefined; }
const { locale, category, tools, alternates, image } = Astro.props;
const publicPath = getCategoryPath(locale, category.slug);
const ui = getCategoryUi(locale);
const getToolType = (index: number, labels: typeof ui.toolTypes): string => {
  if (index === 0) return labels.primary;
  return index % 2 === 0 ? labels.calibration : labels.reference;
};
---

<ProductionPage title={category.title} description={category.description} {locale} {publicPath} {alternates} {image}>
  <div class="category-production">
    <div class="chrono-atmosphere" aria-hidden="true">
      <span class="chrono-atmosphere-orbit chrono-atmosphere-orbit-one"></span>
      <span class="chrono-atmosphere-orbit chrono-atmosphere-orbit-two"></span>
      <span class="chrono-atmosphere-crosshair chrono-atmosphere-crosshair-one"></span>
      <span class="chrono-atmosphere-crosshair chrono-atmosphere-crosshair-two"></span>
    </div>
    <div class="category-production-inner">
      <ProductionBreadcrumb locale={locale} currentTitle={category.title} />
      <header class="chrono-hero">
        <div class="chrono-hero-copy">
          <p class="chrono-kicker"><span>CHRONO</span><span>{ui.fieldGuide}</span></p>
          <h1>{category.title}</h1>
          <p class="chrono-hero-description">{category.description}</p>
          <div class="chrono-hero-actions">
            <a class="chrono-primary-link" href="#chrono-tools"><span>{ui.useTool}</span><span aria-hidden="true">↘</span></a>
            <span class="chrono-hero-note">{ui.measuredNote}</span>
          </div>
        </div>
        <div class="chrono-instrument" data-chrono-clock role="img" aria-label={ui.instrumentAria}>
          <div class="chrono-instrument-stage">
            <span class="chrono-instrument-glow"></span>
            <span class="chrono-instrument-ring chrono-instrument-ring-outer"></span>
            <span class="chrono-instrument-ring chrono-instrument-ring-mid"></span>
            <span class="chrono-instrument-ring chrono-instrument-ring-inner"></span>
            <span class="chrono-instrument-ticks"></span>
            <span class="chrono-instrument-hand chrono-instrument-hand-long" data-clock-hand="minute"></span>
            <span class="chrono-instrument-hand chrono-instrument-hand-short" data-clock-hand="hour"></span>
            <span class="chrono-instrument-hand chrono-instrument-hand-second" data-clock-hand="second"></span>
            <span class="chrono-instrument-pivot"></span>
            <span class="chrono-instrument-readout" aria-hidden="true">
              <span data-clock-hours>00</span><span class="clock-separator">:</span><span data-clock-minutes>00</span><span class="clock-separator">:</span><span data-clock-seconds>00</span>
            </span>
            <span class="chrono-instrument-label chrono-instrument-label-top">{ui.precisionLabel}</span>
            <span class="chrono-instrument-label chrono-instrument-label-bottom">{ui.localTimeLabel}</span>
          </div>
          <div class="chrono-instrument-caption"><span>{ui.artCaptionLead}</span><strong>{ui.artCaptionMain}</strong></div>
        </div>
      </header>
      <section class="chrono-index" id="chrono-tools" aria-labelledby="chrono-index-title">
        <div class="chrono-index-heading">
          <div>
            <p class="chrono-section-kicker">{ui.indexLabel.replace("{count}", String(tools.length).padStart(2, "0"))}</p>
            <h2 id="chrono-index-title">{ui.indexTitle}</h2>
          </div>
          <p class="chrono-index-intro">{ui.indexIntro}</p>
        </div>
        <div class="category-tools-grid">
          {tools.map((tool, index) => (
            <a href={tool.href} class:list={["category-tool-card", index === 0 ? "is-featured" : "", index % 3 === 1 ? "is-warm" : ""]}>
              <span class="category-tool-index">{String(index + 1).padStart(2, "0")}</span>
              <span class="category-tool-signal" aria-hidden="true"></span>
              <div class="category-tool-meta">
                <span class="category-tool-icon"><Icon name={tool.icon} /></span>
                <span class="category-tool-type">{getToolType(index, ui.toolTypes)}</span>
              </div>
              <h3>{tool.title}</h3>
              <p>{tool.description}</p>
              <span class="category-tool-cta"><span>{ui.useTool}</span><span aria-hidden="true">↗</span></span>
            </a>
          ))}
        </div>
      </section>
      <section class="category-seo-production"><SEORenderer content={{ locale, sections: category.seo }} /></section>
    </div>
  </div>
</ProductionPage>

<script>
  const setupChronoClock = () => {
    const root = document.querySelector<HTMLElement>("[data-chrono-clock]");
    if (!root) return;
    if (root.dataset.ready === "true") return;

    const hourHand = root.querySelector<HTMLElement>('[data-clock-hand="hour"]')!;
    const minuteHand = root.querySelector<HTMLElement>('[data-clock-hand="minute"]')!;
    const secondHand = root.querySelector<HTMLElement>('[data-clock-hand="second"]')!;
    const hoursOutput = root.querySelector<HTMLElement>("[data-clock-hours]")!;
    const minutesOutput = root.querySelector<HTMLElement>("[data-clock-minutes]")!;
    const secondsOutput = root.querySelector<HTMLElement>("[data-clock-seconds]")!;

    root.dataset.ready = "true";
    let frame = 0;
    const render = () => {
      const now = new Date();
      const seconds = now.getSeconds() + now.getMilliseconds() / 1000;
      const minutes = now.getMinutes() + seconds / 60;
      const hours = (now.getHours() % 12) + minutes / 60;

      hourHand.style.transform = `rotate(${hours * 30}deg)`;
      minuteHand.style.transform = `rotate(${minutes * 6}deg)`;
      secondHand.style.transform = `rotate(${seconds * 6}deg)`;
      hoursOutput.textContent = String(now.getHours()).padStart(2, "0");
      minutesOutput.textContent = String(now.getMinutes()).padStart(2, "0");
      secondsOutput.textContent = String(now.getSeconds()).padStart(2, "0");
      frame = requestAnimationFrame(render);
    };

    const stop = () => cancelAnimationFrame(frame);
    window.addEventListener("pagehide", stop, { once: true });
    render();
  };

  setupChronoClock();
  document.addEventListener("astro:page-load", setupChronoClock);
</script>
